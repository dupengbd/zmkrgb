 * SPDX-License-Identifier: MIT
 *
 * 合并 sofle + zmkdp 键位映射
 * 保留 zmkdp 三模布局 + sofle 自定义行为(RGB FX、OLED 动画、动态宏、鼠标滚轮、可编辑编码器)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb_fx.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        /* 切换右 OLED 动画 (gem/cat/head/spaceman/pokemon/logo) */
        oledanim: oledanim {
            compatible = "zmk,behavior-oled-anim";
            #binding-cells = <0>;
        };

        /* 运行时可编辑宏 (&dmac N 播放槽位 N) */
        dmac: dmac {
            compatible = "zmk,behavior-dynamic-macro";
            #binding-cells = <1>;
        };

        /* 离散鼠标滚轮 (&mwheel 0=上 1=下 2=左 3=右) */
        mwheel: mwheel {
            compatible = "zmk,behavior-mouse-wheel";
            #binding-cells = <1>;
        };

        /* 可运行时编辑的编码器旋转行为 (通过 ZMK Studio 实时修改并持久化) */
        /* sensor-index: 0 = 左编码器, 1 = 右编码器 */
        /* layer-id: 0 = Default, 1 = Lower, 2 = Raise */

        enc_l0: enc_l0 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <0>;
            layer-id = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        enc_r0: enc_r0 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <1>;
            layer-id = <0>;
            bindings = <&mwheel 0>, <&mwheel 1>;
        };

        enc_l1: enc_l1 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <0>;
            layer-id = <1>;
            bindings = <&rgbfx RGBFX_NEXT(0)>, <&rgbfx RGBFX_PREVIOUS(0)>;
        };

        enc_r1: enc_r1 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <1>;
            layer-id = <1>;
            bindings = <&rgbfx RGBFX_HUE_UP(0)>, <&rgbfx RGBFX_HUE_DOWN(0)>;
        };

        enc_l2: enc_l2 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <0>;
            layer-id = <2>;
            bindings = <&rgbfx RGBFX_BRIGHTEN(0)>, <&rgbfx RGBFX_DIM(0)>;
        };

        enc_r2: enc_r2 {
            compatible = "zmk,behavior-sensor-rotate-dynamic";
            #sensor-binding-cells = <0>;
            sensor-index = <1>;
            layer-id = <2>;
            bindings = <&rgbfx RGBFX_SPD_UP(0)>, <&rgbfx RGBFX_SPD_DOWN(0)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |  6   |                         |  6   |  7    |  8    |  9   |   0   |  `   |  |      |      |       |       |
// |  TAB  |  Q  |  W  |  E   |  R   |  T   |  Y   |                         |  Y   |  U    |  I    |  O   |   P   |  -   |  |      |      |       |       |
// |  CTRL |  A  |  S  |  D   |  F   |  G   |  H   |                         |  H   |  J    |  K    |  L   |   ;   |  '   |  |      |      |       |       |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   |  N   |                         |  N   |  M    |  ,    |  .   |   /   | SHIFT|  |      |      |       |       |
//               | ALT | GUI  | LOWER| SPACE|      |                         | ENTER| RAISE | BSPC  | GUI  |               |      |      |       |       |
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6                        &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp GRAVE
&kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y                         &kp Y     &kp U     &kp I     &kp O     &kp P     &kp MINUS
&kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G     &kp H                         &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N                         &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
           &kp LALT  &kp LGUI  &mo 1     &kp SPACE  &trans                          &kp RET  &mo 2     &kp BSPC  &kp RGUI
            >;

            sensor-bindings = <&enc_l0 &enc_r0>;
        };

        lower_layer {
            display-name = "Lower";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |      |                    |      |  F7  |  F8  |  F9  | F10  | F11  | F12 |  |      |      |       |       |
// |RGBTOG | RGB | RGB | RGB  |  F4  |  F5  |  F6  |                    |      |      |  UP  |OLED  |      | BKSP |     |  |      |      |       |       |
// |  `    |  !  |  @  |  #   |  $   |  %   |      |                    |      | LEFT | DOWN | RIGHT|      |  |   |     |  |      |      |       |       |
// |       |EPON |EPOFF|EPTOG |      |      |      |    |        |      |      |  _   |  +   |  {   |  }   |  \  |     |  |      |      |       |       |
//               |     |      |      |      |      |                    |      |      |       |       |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans        &trans    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&rgbfx RGBFX_TOGGLE(0) &rgbfx RGBFX_ON(0) &rgbfx RGBFX_OFF(0) &rgbfx RGBFX_NEXT(0) &kp F4 &kp F5 &kp F6   &trans    &trans    &kp UP    &oledanim &trans    &kp BSPC
&kp GRAVE  &kp EXCL    &kp AT     &kp HASH    &kp DOLLAR   &kp PRCNT   &trans          &trans    &kp LEFT  &kp DOWN  &kp RIGHT &trans    &kp PIPE
&trans     &ext_power EP_ON &ext_power EP_OFF &ext_power EP_TOG &trans &trans &trans   &trans    &trans    &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC  &kp BSLH
            &trans      &trans      &trans      &trans      &trans          &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&enc_l1 &enc_r1>;
        };

        raise_layer {
            display-name = "Raise";
// ------------------------------------------------------------------------------------------------------------
// |       |     |     |      |      |      |      |                    |      |       |       |      |       |       |  |      |      |       |       |
// |   `   |  1  |  2  |  3   |  4   |  5   |      |                    |  6   |   7   |   8   |  9   |   0   |       |  |      |      |       |       |
// |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |      |                    |      |  <-   |   v   |  ^   |  ->   |       |  |      |      |       |       |
// |  F7   |  F8 |  F9 |  F10 |  F11 |  F12 |      |    |        | RGB  |      |  +   |   -   |   =   |  [   |   ]   |   \  |  |      |      |       |       |
//               |     |      |      |      |      |                    |      |       |       |
            bindings = <
&trans    &trans &trans &trans  &trans  &trans  &trans          &trans    &trans    &trans    &trans   &trans    &trans
&kp GRAVE &kp N1 &kp N2 &kp N3  &kp N4  &kp N5  &trans          &kp N6    &kp N7    &kp N8    &kp N9   &kp N0    &trans
&kp F1    &kp F2 &kp F3 &kp F4  &kp F5  &kp F6  &trans          &trans    &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT &trans
&kp F7    &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans  &trans  &rgbfx RGBFX_TOGGLE(0) &trans &kp KP_PLUS &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
          &trans  &trans  &trans  &trans  &trans          &trans    &trans    &trans
            >;

            sensor-bindings = <&enc_l2 &enc_r2>;
        };
    };
};

/* 编码器每刻度触发一个旋转事件 (30 刻度编码器) */
&left_encoder {
    steps = <60>;
};

&right_encoder {
    steps = <60>;
};

&sensors {
    triggers-per-rotation = <30>;
};
